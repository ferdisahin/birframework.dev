{
  "name": "birjs.com",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"vite,server\" -c \"cyan,green\" \"npm:dev:vite\" \"npm:dev:server\"",
    "dev:server": "node --import tsx --watch app.js",
    "dev:vite": "vite",
    "build": "vite build",
    "start": "node --import tsx app.js"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.6",
    "birframework": "^0.5.29",
    "marked": "^18.3.0",
    "preact": "^10.25.0",
    "preact-render-to-string": "^6.8.3",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
