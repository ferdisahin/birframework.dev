<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - BirFramework</title>

  <!-- Theme Script (System & Saved Theme Detection) -->
  <script>
    (function() {
      var stored = localStorage.getItem('bir-theme');
      var isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (isDark) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
        if (!localStorage.getItem('bir-theme')) {
          if (e.matches) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
      });
    })();
  </script>

  <!-- Primary Meta Tags -->
  <meta name="description" content="{{ description ? description : 'The full-stack web framework for Node.js and TypeScript. Laravel developer ergonomics paired with sub-millisecond persistent-memory V8 speed.' }}">
  <meta name="keywords" content="birframework, nodejs, typescript, fullstack, framework, laravel, blade, turbo, active record, orm, web framework">
  <meta name="author" content="Ferdi Sahin">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="{{ canonical ? canonical : 'https://birframework.dev' }}">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical ? canonical : 'https://birframework.dev/' }}">
  <meta property="og:title" content="{{ title }} - BirFramework">
  <meta property="og:description" content="{{ description ? description : 'The full-stack web framework for Node.js and TypeScript. Laravel ergonomics with persistent-memory speed.' }}">
  <meta property="og:site_name" content="BirFramework">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} - BirFramework">
  <meta name="twitter:description" content="{{ description ? description : 'The full-stack web framework for Node.js and TypeScript. Laravel ergonomics with persistent-memory speed.' }}">

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "BirFramework",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Cross-platform (Node.js 22+, Bun)",
    "description": "The full-stack web framework for Node.js and TypeScript providing Laravel ergonomics with persistent-memory V8 speed.",
    "url": "https://birframework.dev",
    "author": {
      "@type": "Person",
      "name": "Ferdi Sahin"
    },
    "license": "https://opensource.org/licenses/MIT"
  }
  </script>

  <!-- Typography: Inter Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Compiled Application CSS (Tailwind v4) -->
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="bg-white text-zinc-900 dark:bg-black dark:text-zinc-100 min-h-screen flex flex-col font-sans antialiased selection:bg-zinc-200 dark:selection:bg-zinc-800 selection:text-zinc-900 dark:selection:text-white transition-colors duration-150">

  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-50 bg-white/80 dark:bg-black/80 backdrop-blur border-b border-zinc-200 dark:border-zinc-900">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-zinc-900 dark:text-white hover:opacity-90 transition">
          <svg class="w-5 h-5 text-zinc-900 dark:text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
          <span class="text-base tracking-tight font-semibold">BirFramework</span>
          <span class="text-[11px] text-zinc-600 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 px-2 py-0.5 rounded-full ml-1 font-medium tabular-nums">v{{ version }}</span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm text-zinc-600 dark:text-zinc-400 font-normal">
          <a href="/docs/installation" class="hover:text-zinc-900 dark:hover:text-white transition">Documentation</a>
          <a href="/#benchmarks" class="hover:text-zinc-900 dark:hover:text-white transition">Benchmarks</a>
          <a href="/#architecture" class="hover:text-zinc-900 dark:hover:text-white transition">Architecture</a>
          <a href="/#ecosystem" class="hover:text-zinc-900 dark:hover:text-white transition">Ecosystem</a>
        </nav>
      </div>

      <div class="flex items-center gap-3">
        <!-- Theme Toggle Button -->
        <button id="theme-toggle" type="button" aria-label="Toggle Theme" class="p-1.5 rounded-md text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition">
          <!-- Sun icon (shown in dark mode) -->
          <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <a href="/docs/installation" class="hidden sm:inline-flex text-xs text-zinc-700 dark:text-zinc-300 bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-900 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 px-3 py-1.5 rounded-md transition items-center gap-2 font-medium">
          <span>npx birframework new</span>
          <span class="text-zinc-400 dark:text-zinc-500">→</span>
        </a>

        <a href="https://github.com/ferdisahin/BirFramework" target="_blank" rel="noopener noreferrer" class="text-xs text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-900 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 px-3 py-1.5 rounded-md transition font-medium flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Page Slot -->
  <main class="flex-1">
    {!! slot !!}
  </main>

  <!-- Clean Footer -->
  <footer class="border-t border-zinc-200 dark:border-zinc-900 bg-zinc-50 dark:bg-black text-xs text-zinc-500 py-12">
    <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <span class="font-semibold text-zinc-700 dark:text-zinc-300">BirFramework</span>
        <span>•</span>
        <span>Open-source software licensed under MIT</span>
      </div>

      <div class="flex items-center gap-6">
        <a href="/docs/installation" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">Docs</a>
        <a href="https://github.com/ferdisahin/BirFramework" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">Repository</a>
        <a href="https://www.npmjs.com/package/birframework" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">npm</a>
        <a href="/api/health" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">API Status</a>
      </div>
    </div>
  </footer>

  <!-- Scripts: Copy & Theme Toggle -->
  <script>
    document.addEventListener('click', (e) => {
      // 1. Copy Button Handler
      const copyBtn = e.target.closest('[data-copy]');
      if (copyBtn) {
        const selector = copyBtn.getAttribute('data-copy');
        const target = document.querySelector(selector);
        if (target) {
          navigator.clipboard.writeText(target.innerText.trim());
          const original = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span class="text-emerald-500 dark:text-emerald-400 font-medium text-[11px]">Copied</span>';
          setTimeout(() => { copyBtn.innerHTML = original; }, 2000);
        }
      }

      // 2. Theme Toggle Handler
      const themeBtn = e.target.closest('#theme-toggle');
      if (themeBtn) {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('bir-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('bir-theme', 'dark');
        }
      }
    });
  </script>

  {!! bir_scripts() !!}
</body>
</html>
