<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - BirJS</title>

  <!-- Theme Script (System & Saved Theme Detection) -->
  <script>
    (function() {
      var stored = localStorage.getItem('bir-theme');
      var isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (isDark) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
        if (!localStorage.getItem('bir-theme')) {
          if (e.matches) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
      });
    })();
  </script>

  <!-- Primary Meta Tags -->
  <meta name="description" content="{{ description ? description : 'BirJS: The full-stack web framework for Node.js and TypeScript. Laravel developer ergonomics paired with sub-millisecond persistent-memory V8 speed.' }}">
  <meta name="keywords" content="birjs, nodejs, typescript, fullstack, framework, laravel, blade, turbo, active record, orm, web framework">
  <meta name="author" content="Ferdi Sahin">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="{{ canonical ? canonical : 'https://birjs.com' }}">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical ? canonical : 'https://birjs.com/' }}">
  <meta property="og:title" content="{{ title }} - BirJS">
  <meta property="og:description" content="{{ description ? description : 'BirJS: The full-stack web framework for Node.js and TypeScript. Laravel ergonomics with persistent-memory speed.' }}">
  <meta property="og:site_name" content="BirJS">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} - BirJS">
  <meta name="twitter:description" content="{{ description ? description : 'BirJS: The full-stack web framework for Node.js and TypeScript. Laravel ergonomics with persistent-memory speed.' }}">

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "BirJS",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Cross-platform (Node.js 22+, Bun)",
    "description": "BirJS: The full-stack web framework for Node.js and TypeScript providing Laravel ergonomics with persistent-memory V8 speed.",
    "url": "https://birjs.com",
    "author": {
      "@type": "Person",
      "name": "Ferdi Sahin"
    },
    "license": "https://opensource.org/licenses/MIT"
  }
  </script>

  <!-- Typography: Inter Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Modern Vite Assets -->
  @vite(['resources/css/app.css'])
</head>
<body class="bg-white text-zinc-900 dark:bg-black dark:text-zinc-100 min-h-screen flex flex-col font-sans antialiased selection:bg-zinc-200 dark:selection:bg-zinc-800 selection:text-zinc-900 dark:selection:text-white transition-colors duration-150">

  <!-- Top Navigation Bar Component -->
  <x-navbar />

  <!-- Page Slot -->
  <main class="flex-1">
    {!! slot !!}
  </main>

  <!-- Clean Footer Component -->
  <x-footer />

  <!-- Scripts: Copy & Theme Toggle -->
  <script>
    document.addEventListener('click', (e) => {
      // 1. Copy Button Handler
      const copyBtn = e.target.closest('[data-copy]');
      if (copyBtn) {
        const selector = copyBtn.getAttribute('data-copy');
        const target = document.querySelector(selector);
        if (target) {
          navigator.clipboard.writeText(target.innerText.trim());
          const original = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span class="text-emerald-500 dark:text-emerald-400 font-medium text-[11px]">Copied</span>';
          setTimeout(() => { copyBtn.innerHTML = original; }, 2000);
        }
      }

      // 2. Theme Toggle Handler
      const themeBtn = e.target.closest('#theme-toggle');
      if (themeBtn) {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('bir-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('bir-theme', 'dark');
        }
      }
    });
  </script>

  <!-- Instant Turbo Navigation (Clean Production) -->
  <style id="bir-turbo-styles">
    #bir-turbo-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 2px;
      width: 0%;
      background: linear-gradient(90deg, #38bdf8, #818cf8);
      z-index: 999999;
      transition: width 0.2s ease, opacity 0.3s ease;
      pointer-events: none;
    }
  </style>
  <script id="bir-turbo-script">
  (function() {
    if (window.__BIR_TURBO_INITIALIZED__) return;
    window.__BIR_TURBO_INITIALIZED__ = true;

    var bar = document.createElement('div');
    bar.id = 'bir-turbo-progress';
    document.documentElement.appendChild(bar);

    function startProgress() {
      bar.style.opacity = '1';
      bar.style.width = '30%';
      setTimeout(function() { if (bar.style.opacity === '1') bar.style.width = '70%'; }, 150);
    }

    function finishProgress() {
      bar.style.width = '100%';
      setTimeout(function() {
        bar.style.opacity = '0';
        setTimeout(function() { bar.style.width = '0%'; }, 300);
      }, 150);
    }

    function shouldIntercept(anchor) {
      if (!anchor || anchor.tagName !== 'A') return false;
      if (anchor.target && anchor.target !== '_self') return false;
      if (anchor.hasAttribute('download')) return false;
      if (anchor.getAttribute('data-no-turbo') !== null) return false;
      var href = anchor.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('javascript:')) return false;
      try {
        var url = new URL(anchor.href, window.location.href);
        if (url.origin !== window.location.origin) return false;
        if (url.pathname === window.location.pathname && url.hash) return false;
        return true;
      } catch (e) { return false; }
    }

    function navigate(url, pushState) {
      startProgress();
      var parsedUrl;
      try { parsedUrl = new URL(url, window.location.href); } catch (e) {}
      var targetHash = parsedUrl && parsedUrl.hash ? parsedUrl.hash : '';

      fetch(url, { headers: { 'X-Bir-Turbo': 'true' } })
        .then(function(res) {
          if (!res.ok) { window.location.href = url; return; }
          return res.text();
        })
        .then(function(html) {
          if (!html) return;
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          if (doc.title) document.title = doc.title;

          document.body.innerHTML = doc.body.innerHTML;

          if (pushState) window.history.pushState({ turbo: true, url: url }, '', url);
          if (targetHash) {
            try {
              var targetEl = document.querySelector(targetHash);
              if (targetEl) targetEl.scrollIntoView({ behavior: 'smooth' });
              else window.scrollTo(0, 0);
            } catch(e) { window.scrollTo(0, 0); }
          } else {
            window.scrollTo(0, 0);
          }
          finishProgress();
        })
        .catch(function() {
          finishProgress();
          window.location.href = url;
        });
    }

    document.addEventListener('click', function(e) {
      var anchor = e.target.closest('a');
      if (!anchor) return;
      var href = anchor.getAttribute('href');
      if (!href) return;

      if (href.startsWith('#') || (href.startsWith('/#') && (window.location.pathname === '/' || window.location.pathname === ''))) {
        var hash = href.startsWith('/#') ? href.slice(1) : href;
        try {
          var target = document.querySelector(hash);
          if (target) {
            e.preventDefault();
            window.history.pushState(null, '', href);
            target.scrollIntoView({ behavior: 'smooth' });
            return;
          }
        } catch (err) {}
      }

      if (shouldIntercept(anchor)) {
        e.preventDefault();
        navigate(anchor.href, true);
      }
    });

    window.addEventListener('popstate', function() {
      navigate(window.location.href, false);
    });
  })();
  </script>
</body>
</html>
