    },
    testing: {
      title: "Built-in HTTP Testing Client",
      desc: "Write clean, fluent integration and end-to-end tests using the native Node.js test runner. No external HTTP server or port conflicts.",
      bullets: [
        "Native Node.js test runner integration (<code class='font-medium text-zinc-900 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded'>node:test</code>)",
        "Fluent assertions: <code class='font-medium text-zinc-900 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded'>assertOk()</code>, <code class='font-medium text-zinc-900 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded'>assertSee()</code>, <code class='font-medium text-zinc-900 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded'>assertJson()</code>",
        "Automatic cookie, session, and redirect tracking",
        "Fast in-memory execution in under 2 seconds"
      ],
