<!-- Open Source Reference Projects Component -->
<section id="ecosystem" class="py-20 border-b border-zinc-200 dark:border-zinc-800">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Real-World Codebases</h2>
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">Open-source reference applications</h3>
      </div>
      <span class="text-xs text-zinc-500">100% automated test coverage</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Project 1: BirBlog -->
      <div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
        <div class="flex items-center justify-between mb-4">
          <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
            CMS &amp; Publishing
          </span>
          <span class="text-xs text-zinc-400">bir-blog</span>
        </div>
        <h4 class="text-lg font-bold text-zinc-950 dark:text-white">BirBlog Platform</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Full publishing architecture featuring user authentication, FormRequest validation, automated slug generation, nested article comments, and .bir template layouts.
        </p>
        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between text-xs">
          <span class="text-zinc-500 font-medium">6 / 6 feature tests pass</span>
          <a href="https://github.com/ferdisahin/BirFramework" target="_blank" class="font-medium text-zinc-900 dark:text-white hover:underline flex items-center gap-1">
            Source Code &rarr;
          </a>
        </div>
      </div>

      <!-- Project 2: CloudForge SaaS -->
      <div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
        <div class="flex items-center justify-between mb-4">
          <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
            SaaS &amp; Metered Billing
          </span>
          <span class="text-xs text-zinc-400">bir-saas</span>
        </div>
        <h4 class="text-lg font-bold text-zinc-950 dark:text-white">CloudForge Platform</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Multi-tier subscription billing, automated PDF invoice generation, metered developer API keys, usage metrics tracking, and background subscription renewals.
        </p>
        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between text-xs">
          <span class="text-zinc-500 font-medium">6 / 6 feature tests pass</span>
          <a href="https://github.com/ferdisahin/BirFramework" target="_blank" class="font-medium text-zinc-900 dark:text-white hover:underline flex items-center gap-1">
            Source Code &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
