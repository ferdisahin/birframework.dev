<!-- Hero Section Component -->
<section class="relative pt-20 sm:pt-32 pb-20 border-b border-zinc-200 dark:border-zinc-800">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-3xl">
      <!-- Release Badge -->
      <a href="/docs/installation" class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-zinc-100 hover:bg-zinc-200/80 dark:bg-zinc-900 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 text-xs text-zinc-700 dark:text-zinc-300 transition mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="font-medium">BirJS v{{ version }} is now available</span>
        <span class="text-zinc-400 dark:text-zinc-600">&rarr;</span>
      </a>

      <!-- Headline -->
      <h1 class="text-5xl sm:text-7xl font-extrabold tracking-tight text-zinc-950 dark:text-white leading-[1.05]">
        The full-stack framework for TypeScript artisans.
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
        Laravel developer ergonomics paired with sub-millisecond persistent-memory V8 speed. ActiveRecord ORM, background queues, WebSockets, Type-Safe JSX Server Components, and the unified 4-service dev suite.
      </p>

      <!-- Command & CTA Actions -->
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <div class="flex items-center justify-between bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 px-4 py-2.5 rounded-lg text-xs text-zinc-900 dark:text-zinc-200 min-w-[280px]">
          <div class="flex items-center gap-2">
            <span class="text-zinc-400 select-none">$</span>
            <span id="cmd-install" class="select-all font-medium">npx birframework new my-app</span>
          </div>
          <button data-copy="#cmd-install" class="text-zinc-500 hover:text-zinc-950 dark:hover:text-white text-[11px] pl-3 border-l border-zinc-300 dark:border-zinc-700 font-medium transition cursor-pointer">
            Copy
          </button>
        </div>

        <a href="/docs/installation" class="px-5 py-2.5 rounded-lg bg-zinc-950 hover:bg-zinc-800 text-white dark:bg-white dark:hover:bg-zinc-100 dark:text-zinc-950 text-xs font-semibold transition flex items-center justify-center gap-1.5 shadow-xs">
          <span>Read the Docs</span>
          <span>&rarr;</span>
        </a>

        <a href="https://github.com/ferdisahin/BirFramework" target="_blank" class="px-5 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white hover:bg-zinc-50 dark:bg-zinc-900 dark:hover:bg-zinc-800 text-zinc-800 dark:text-zinc-200 text-xs font-medium transition flex items-center justify-center gap-1.5">
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <!-- Live Metrics Strip -->
    <div class="mt-14 pt-8 border-t border-zinc-200 dark:border-zinc-800/80 grid grid-cols-2 sm:grid-cols-4 gap-6 text-xs">
      <div>
        <div class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">7,899</div>
        <div class="text-zinc-500 mt-1">Requests per second</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">1.26ms</div>
        <div class="text-zinc-500 mt-1">Average loopback latency</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400">204 / 204</div>
        <div class="text-zinc-500 mt-1">Automated test suites pass</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">3 Databases</div>
        <div class="text-zinc-500 mt-1">SQLite, PostgreSQL, MySQL</div>
      </div>
    </div>
  </div>
</section>
