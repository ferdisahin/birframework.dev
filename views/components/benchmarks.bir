<!-- Side-by-Side Empirical Benchmarks Component -->
<section id="benchmarks" class="py-20 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50/40 dark:bg-zinc-950/40">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-2xl mb-8">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Benchmark Performance</h2>
      <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">Measured performance on local loopback.</h3>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
        Tested on Apple Silicon macOS with 5,000 requests (concurrency = 10). Persistent V8 in-memory execution delivers consistent sub-millisecond response times.
      </p>
    </div>

    <div class="border border-zinc-200 dark:border-zinc-800 rounded-xl overflow-hidden bg-white dark:bg-zinc-950 shadow-xs">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 text-[11px] bg-zinc-50 dark:bg-zinc-900/60 uppercase tracking-wider">
              <th class="py-3 px-5 font-semibold">Framework</th>
              <th class="py-3 px-5 font-semibold">Runtime / Engine</th>
              <th class="py-3 px-5 font-semibold text-right">Throughput</th>
              <th class="py-3 px-5 font-semibold text-right">Average Latency</th>
              <th class="py-3 px-5 font-semibold text-right">p99 Latency</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800 text-zinc-700 dark:text-zinc-300">
            <tr class="bg-emerald-500/[0.04] dark:bg-emerald-500/[0.08]">
              <td class="py-3.5 px-5 font-bold text-zinc-950 dark:text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                BirJS v{{ version }}
              </td>
              <td class="py-3.5 px-5 text-zinc-500 dark:text-zinc-400">Node.js 22+ (Persistent V8)</td>
              <td class="py-3.5 px-5 text-right text-emerald-600 dark:text-emerald-400 font-bold">7,899 req/s</td>
              <td class="py-3.5 px-5 text-right font-semibold text-zinc-900 dark:text-white">1.26 ms</td>
              <td class="py-3.5 px-5 text-right">4.00 ms</td>
            </tr>
            <tr>
              <td class="py-3.5 px-5 font-medium text-zinc-900 dark:text-zinc-200">Next.js 16 (App Router)</td>
              <td class="py-3.5 px-5 text-zinc-500">Node.js 22+ (React Server Components)</td>
              <td class="py-3.5 px-5 text-right text-zinc-600 dark:text-zinc-400">7,097 req/s</td>
              <td class="py-3.5 px-5 text-right text-zinc-600 dark:text-zinc-400">1.40 ms</td>
              <td class="py-3.5 px-5 text-right">4.00 ms</td>
            </tr>
            <tr>
              <td class="py-3.5 px-5 text-zinc-600 dark:text-zinc-400">Laravel 13</td>
              <td class="py-3.5 px-5 text-zinc-500">PHP 8.5 (FPM / CLI Per-Request Boot)</td>
              <td class="py-3.5 px-5 text-right text-zinc-500">300 req/s</td>
              <td class="py-3.5 px-5 text-right text-zinc-500">33.38 ms</td>
              <td class="py-3.5 px-5 text-right text-zinc-500">71.00 ms</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
