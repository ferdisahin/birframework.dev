<!-- Complete Architecture Capabilities Component -->
<section id="architecture" class="py-20 border-b border-zinc-200 dark:border-zinc-800">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-2xl mb-14">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Integrated Platform</h2>
      <h3 class="text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">Built for shipping real applications.</h3>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
        Every component is designed to work together seamlessly without configuration conflicts.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- 1. ORM & Query Builder -->
      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="text-xs font-semibold text-zinc-400 mb-2">01 / PERSISTENCE</div>
        <h4 class="text-base font-bold text-zinc-950 dark:text-white">ActiveRecord ORM</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Fluent query building, relationships, model lifecycle hooks, and soft deletes. Connect seamlessly to SQLite, PostgreSQL, or MySQL via dialect translation.
        </p>
        <a href="/docs/models" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-200 hover:underline mt-4">
          Learn more &rarr;
        </a>
      </div>

      <!-- 2. Unified Preact + Inertia + SSR -->
      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="text-xs font-semibold text-zinc-400 mb-2">02 / UNIFIED FRONTEND</div>
        <h4 class="text-base font-bold text-zinc-950 dark:text-white">Preact + Inertia + SSR</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          One TSX standard across your entire app. Server-rendered HTML on first load for SEO, plus instant <code class="px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 font-medium">&lt;Link&gt;</code> SPA transitions and full <code class="px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 font-medium">useState</code> interactivity.
        </p>
        <a href="/docs/inertia" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-200 hover:underline mt-4">
          Learn more &rarr;
        </a>
      </div>

      <!-- 3. Queues, Retries & Mail -->
      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="text-xs font-semibold text-zinc-400 mb-2">03 / ASYNC &amp; MAIL</div>
        <h4 class="text-base font-bold text-zinc-950 dark:text-white">Queues, Cron &amp; Resend/SMTP</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Failed-job dead-letter table with <code class="px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 font-medium">queue:retry</code>, non-overlapping cron locks, and zero-dependency Resend &amp; SMTP mail drivers with PDF attachments.
        </p>
        <a href="/docs/queues" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-200 hover:underline mt-4">
          Learn more &rarr;
        </a>
      </div>

      <!-- 4. WebSockets & Real-Time -->
      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="text-xs font-semibold text-zinc-400 mb-2">04 / REAL-TIME</div>
        <h4 class="text-base font-bold text-zinc-950 dark:text-white">WebSockets &amp; Broadcast</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Built-in RFC 6455 WebSocket server. Broadcast real-time notifications, chat messages, or status updates to channels without external SaaS dependencies.
        </p>
        <a href="/docs/events" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-200 hover:underline mt-4">
          Learn more &rarr;
        </a>
      </div>

      <!-- 5. 4-Service Dev Dashboard -->
      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="text-xs font-semibold text-zinc-400 mb-2">05 / DEV EXPERIENCE</div>
        <h4 class="text-base font-bold text-zinc-950 dark:text-white">4-Service Dev Suite</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Run HTTP server, queue worker, log streamer, and Vite concurrently in a single terminal. Features automatic port increment when port 3000 is occupied.
        </p>
        <a href="/docs/dev-server" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-200 hover:underline mt-4">
          Learn more &rarr;
        </a>
      </div>

      <!-- 6. Structured Logging & Pail -->
      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="text-xs font-semibold text-zinc-400 mb-2">06 / OBSERVABILITY</div>
        <h4 class="text-base font-bold text-zinc-950 dark:text-white">Logging &amp; Bir Pail</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Unified <code class="px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 font-medium">Log</code> facade with structured file output and an interactive CLI tailer displaying colorized ANSI category badges.
        </p>
        <a href="/docs/logging" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-200 hover:underline mt-4">
          Learn more &rarr;
        </a>
      </div>

      <!-- 7. Interactive Debug Screen -->
      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="text-xs font-semibold text-zinc-400 mb-2">07 / ERROR HANDLING</div>
        <h4 class="text-base font-bold text-zinc-950 dark:text-white">Ignition Debug Screen</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Interactive in-browser exception inspector. Displays highlighted source code frames, environment variables, request headers, and solution hints in development.
        </p>
        <a href="/docs/error-handling" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-200 hover:underline mt-4">
          Learn more &rarr;
        </a>
      </div>

      <!-- 8. Tailwind CSS v4 & Vite -->
      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="text-xs font-semibold text-zinc-400 mb-2">08 / FRONTEND TOOLING</div>
        <h4 class="text-base font-bold text-zinc-950 dark:text-white">Tailwind v4 &amp; Vite HMR</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          First-class Tailwind CSS v4 with <code class="px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 font-medium">@source</code> scanning for backend views, combined with an automated full-reload template watcher.
        </p>
        <a href="/docs/dev-server" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-200 hover:underline mt-4">
          Learn more &rarr;
        </a>
      </div>

      <!-- 9. Artisan-Class CLI -->
      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6">
        <div class="text-xs font-semibold text-zinc-400 mb-2">09 / COMMAND LINE</div>
        <h4 class="text-base font-bold text-zinc-950 dark:text-white">Artisan-Style CLI</h4>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Scaffold models, migrations, seeders, controllers, jobs, and mailables with simple <code class="px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 font-medium">bir make:*</code> commands. Inspect routes with <code class="px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 font-medium">bir route:list</code>.
        </p>
        <a href="/docs/cli" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-200 hover:underline mt-4">
          Learn more &rarr;
        </a>
      </div>
    </div>
  </div>
</section>
