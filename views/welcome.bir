        <!-- Code Panels -->
        <div class="p-6 text-xs sm:text-[13px] font-mono overflow-x-auto leading-relaxed text-zinc-300 bg-zinc-950 min-h-[340px]">
          <!-- Routes -->
          <pre id="code-routes" class="code-panel"><code>import { Route, type Context } from 'birframework';
import { PostController } from '../app/controllers/PostController.js';

const posts = new PostController();

// Resource controller routing
Route.get('/posts', (ctx: Context) => posts.index(ctx));
Route.get('/posts/:slug', (ctx: Context) => posts.show(ctx));

// Grouped routes with validation and authentication
Route.group({ prefix: '/api/v1', middleware: ['auth'] }, () => {
  Route.post('/posts', async (ctx: Context) => {
    const data = await ctx.validate({
      title: 'required|string|min:3',
      content: 'required|string',
    });
    return ctx.json({ status: 'created', data }, 201);
  });
});

// Blade template view rendering with Instant Turbo navigation
Route.get('/', (ctx: Context) => {
  return ctx.render('welcome', { title: 'BirFramework' });
});</code></pre>

          <!-- Model -->
          <pre id="code-model" class="code-panel hidden"><code>import { Model, DB } from 'birframework';

export class User extends Model {
  public static override table = 'users';
  public static override softDeletes = true;

  // Fluent ActiveRecord Relationships
  public posts() {
    return this.hasMany('posts', 'user_id');
  }

  // Automatic Lifecycle Hook
  public static override boot() {
    this.creating((user) => {
      user.verification_token = crypto.randomUUID();
    });
  }
}

// Fluent querying with full TypeScript inference
const activeUsers = await User.where('status', '=', 'active')
  .orderBy('created_at', 'desc')
  .get();

// Multi-Dialect ACID Transactions (SQLite, PostgreSQL, MySQL)
await DB.transaction(async () => {
  await User.where('id', 1).decrement('balance', 50);
  await User.where('id', 2).increment('balance', 50);
});</code></pre>

          <!-- View -->
          <pre id="code-view" class="code-panel hidden"><code>@verbatim&lt;x-layouts.app title="{{ title }}"&gt;
  &lt;div class="max-w-4xl mx-auto py-12"&gt;
    &lt;h1 class="text-2xl font-bold"&gt;{{ title }}&lt;/h1&gt;

    &lt;!-- Modern Blade Directives --&gt;
    @foreach(posts as post)
      &lt;div class="border-b border-zinc-200 dark:border-zinc-800 py-3"&gt;
        &lt;h2 class="text-sm font-semibold"&gt;{{ post.title }}&lt;/h2&gt;
        &lt;span class="text-xs text-zinc-500"&gt;#{{ post.id }}&lt;/span&gt;
      &lt;/div&gt;
    @endforeach

    &lt;!-- Instant Turbo page navigation --&gt;
    {!! paginationHtml !!}
  &lt;/div&gt;

  &lt;x-slot name="footer"&gt;
    &lt;span class="text-xs text-zinc-500"&gt;Rendered with .bir Template Engine&lt;/span&gt;
  &lt;/x-slot&gt;
&lt;/x-layouts.app&gt;@endverbatim</code></pre>

          <!-- Queue -->
          <pre id="code-queue" class="code-panel hidden"><code>import { Job, dispatch } from 'birframework';

export class SendInvoiceJob extends Job {
  constructor(public invoiceId: number, public userEmail: string) {
    super();
    this.queue = 'billing';
    this.delaySeconds = 60; // Delayed execution
  }

  // Asynchronous background execution via SQLite / Redis queue worker
  public async handle(): Promise&lt;void&gt; {
    console.log(`Sending automated invoice #${this.invoiceId} to ${this.userEmail}`);
  }
}

// Dispatch anywhere from controllers, requests, or CLI
await dispatch(new SendInvoiceJob(1042, 'billing@acme.com'));</code></pre>

          <!-- Broadcast -->
          <pre id="code-broadcast" class="code-panel hidden"><code>import { Broadcast, Route, type Context } from 'birframework';

// Real-Time Event Broadcasting with zero external WebSocket dependencies
Route.post('/orders', async (ctx: Context) => {
  const order = await ctx.body();

  // Instant broadcast to all connected WebSocket clients on channel 'orders'
  Broadcast.to('orders').emit('OrderPlaced', {
    orderId: order.id,
    amount: order.total,
    customer: order.customerName,
  });

  return ctx.json({ status: 'dispatched' });
});</code></pre>

