                <!-- Auth Code -->
                <pre id="code-content-auth"><code>import { Route, Auth, type Context } from 'birframework';
import { User } from './app/models/User.js';

// Login verification
Route.post('/login', async (ctx: Context) => {
  const { email, password } = await ctx.body();

  const success = await Auth.attempt(ctx, User, email, password);
  if (!success) {
    return ctx.back({ error: 'Invalid credentials' });
  }

  return ctx.redirect('/dashboard');
});

// Protected dashboard route group
Route.group({ middleware: ['auth'] }, () => {
  Route.get('/dashboard', async (ctx: Context) => {
    const user = await Auth.user(ctx, User);
    return ctx.render('dashboard', { user });
  });
});</code></pre>

                <!-- ORM Code -->
                <pre id="code-content-orm" class="hidden"><code>import { Model, DB } from 'birframework';

export class User extends Model {
  public static override table = 'users';
  public static override softDeletes = true;

  // Fluent relationships
  public posts() {
    return this.hasMany('posts', 'user_id');
  }
}

// Queries with TypeScript type safety
const user = await User.find(1);
const activeUsers = await User.where('status', '=', 'active')
  .orderBy('created_at', 'desc')
  .get();

// ACID transaction across SQLite, Postgres, or MySQL
await DB.transaction(async () => {
  await User.where('id', 1).decrement('balance', 50);
  await User.where('id', 2).increment('balance', 50);
});</code></pre>

                <!-- Migrations Code -->
                <pre id="code-content-migrations" class="hidden"><code>import { Schema, type Blueprint } from 'birframework';

export default {
  async up() {
    await Schema.create('articles', (table: Blueprint) => {
      table.id();
      table.string('title');
      table.string('slug').unique();
      table.text('content');
      table.boolean('published').default(false);
      table.string('deleted_at').nullable();
      table.timestamps();
    });
  },

  async down() {
    await Schema.dropIfExists('articles');
  }
};</code></pre>

                <!-- Validation Code -->
                <pre id="code-content-validation" class="hidden"><code>import { FormRequest, type ValidationRules } from 'birframework';

export class StorePostRequest extends FormRequest {
  public override async authorize(): Promise&lt;boolean&gt; {
    return this.ctx.session.has('user_id');
  }

  public override rules(): ValidationRules {
    return {
      title: 'required|string|min:3|max:255',
      content: 'required|string',
      category_id: 'required|integer',
      tags: 'nullable|array',
    };
  }
}</code></pre>

                <!-- Templates Code -->
                <pre id="code-content-templates" class="hidden"><code>@verbatim&lt;x-layouts.app title="{{ title }}"&gt;
  &lt;div class="max-w-4xl mx-auto py-12"&gt;
    &lt;h1 class="text-2xl font-bold"&gt;{{ title }}&lt;/h1&gt;

    &lt;!-- Blade Directives --&gt;
    @foreach(posts as post)
      &lt;article class="border-b border-zinc-800 py-4"&gt;
        &lt;h2 class="text-base font-semibold"&gt;{{ post.title }}&lt;/h2&gt;
        &lt;p class="text-xs text-zinc-500"&gt;{{ post.created_at }}&lt;/p&gt;
      &lt;/article&gt;
    @endforeach

    &lt;!-- Instant Turbo page navigation --&gt;
    {!! paginationHtml !!}
  &lt;/div&gt;
&lt;/x-layouts.app&gt;@endverbatim</code></pre>

                <!-- Queues Code -->
                <pre id="code-content-queues" class="hidden"><code>import { Job, dispatch } from 'birframework';

export class SendWelcomeEmailJob extends Job {
  constructor(public userId: number) {
    super();
    this.queue = 'emails';
    this.delaySeconds = 30;
  }

  public async handle(): Promise&lt;void&gt; {
    console.log(`Processing welcome email for user: ${this.userId}`);
  }
}

// Dispatch from anywhere in controllers or events
await dispatch(new SendWelcomeEmailJob(101));</code></pre>

                <!-- Broadcast Code -->
                <pre id="code-content-broadcast" class="hidden"><code>import { Broadcast, Route, type Context } from 'birframework';

// Zero-dependency native WebSockets
Route.post('/orders', async (ctx: Context) => {
  const order = await ctx.body();

  // Instant real-time event broadcast to channel 'orders'
  Broadcast.to('orders').emit('OrderCreated', {
    orderId: order.id,
    customer: order.customerName,
    total: order.total,
  });

  return ctx.json({ status: 'dispatched' });
});</code></pre>

                <!-- Testing Code -->
                <pre id="code-content-testing" class="hidden"><code>import { test, describe, before, after } from 'node:test';
import assert from 'node:assert';
import { app } from '../app.js';
import { createTestClient } from 'birframework';

describe('Application Feature Tests', () => {
  const client = createTestClient(app);

  test('Guest can view articles and single post', async () => {
    const res = await client.get('/posts');
    res.assertOk()
       .assertSee('Articles');

    const detail = await client.get('/posts/first-post');
    detail.assertOk()
          .assertSee('My First Post');
  });
});</code></pre>

