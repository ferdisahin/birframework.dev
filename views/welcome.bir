    <div class="max-w-3xl mx-auto px-6">
      <h3 class="text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">
        Start building with BirFramework.
      </h3>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-3 max-w-lg mx-auto leading-relaxed">
        Scaffold your database, models, routes, and views in under 30 seconds.
      </p>
      <div class="mt-6 flex items-center justify-center gap-3">
        <a href="/docs/installation" class="bg-zinc-950 hover:bg-zinc-800 text-white dark:bg-white dark:hover:bg-zinc-100 dark:text-zinc-950 px-5 py-2.5 rounded-lg font-semibold text-xs transition shadow-xs">
          Get Started &rarr;
        </a>
        <a href="https://github.com/ferdisahin/BirFramework" target="_blank" class="bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-900 dark:hover:bg-zinc-800 text-zinc-800 dark:text-zinc-200 px-5 py-2.5 rounded-lg font-medium text-xs border border-zinc-200 dark:border-zinc-800 transition">
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Switcher Script -->
  <script>
    const showcaseData = {
      auth: {
        title: "Authentication out of the box",
        desc: "BirFramework gives you session-based cookie authentication, password hashing with Argon2/Bcrypt, CSRF verification, and route protection with zero external setup.",
        bullets: [
          "Complete scaffold with <code class='font-mono'>bir make:auth</code>",
          "Encrypted session cookies with tamper protection",
          "Automatic <code class='font-mono'>Auth.attempt()</code> and <code class='font-mono'>Auth.user()</code>",
          "Native middleware for protected route groups"
        ],
        link: "/docs/security",
        tab1: "routes/web.ts",
        tab2: "AuthController.ts"
      },
      orm: {
        title: "ActiveRecord ORM & Database",
        desc: "Fluent ActiveRecord querying, model lifecycle hooks, relationships (hasMany, belongsTo), and soft deletes across SQLite, PostgreSQL, and MySQL.",
        bullets: [
          "Type-inferred queries with TypeScript generics",
          "Lifecycle hooks (<code class='font-mono'>beforeCreate</code>, <code class='font-mono'>saved</code>)",
          "Built-in soft deletes (<code class='font-mono'>post.delete()</code>, <code class='font-mono'>Post.withTrashed()</code>)",
          "ACID transactions with automatic rollback on error"
        ],
        link: "/docs/database",
        tab1: "app/models/User.ts",
        tab2: "database.sqlite"
      },
      migrations: {
        title: "Declarative Schema Migrations",
        desc: "Design and alter database tables using a fluent, declarative schema builder. Migrations run in batches with full rollback support.",
        bullets: [
          "Auto-generated timestamps with <code class='font-mono'>bir make:migration</code>",
          "Fluent column types: string, text, integer, boolean, timestamps",
          "Unique constraints, nullable fields, foreign keys",
          "Rollback batch management with <code class='font-mono'>bir migrate:rollback</code>"
        ],
        link: "/docs/database",
        tab1: "migrations/create_articles.ts",
        tab2: "Schema.ts"
      },
      validation: {
        title: "Request Validation & FormRequests",
        desc: "Validate incoming request payloads cleanly. FormRequest classes isolate validation logic, sanitization, and authorization from controllers.",
        bullets: [
          "Class-based requests with <code class='font-mono'>bir make:request</code>",
          "Declarative rules (<code class='font-mono'>required|email|min:6</code>)",
          "Automatic 422 Unprocessable Entity responses with structured errors",
          "Integrated authorization checks with <code class='font-mono'>authorize()</code>"
        ],
        link: "/docs/validation",
        tab1: "app/requests/StorePostRequest.ts",
        tab2: "Validator.ts"
      },
      templates: {
        title: ".bir Blade Template Engine",
        desc: "Modern Blade components, slots, and directives compiled natively on the server. Instant Turbo navigation gives SPA speed without JavaScript bundle bloat.",
        bullets: [
          "Native <code class='font-mono'>.bir</code> template files in <code class='font-mono'>views/</code>",
          "Blade directives (<code class='font-mono'>@if</code>, <code class='font-mono'>@foreach</code>, <code class='font-mono'>@verbatim</code>)",
          "Component tags (<code class='font-mono'>&lt;x-layouts.app&gt;</code>, <code class='font-mono'>&lt;x-slot&gt;</code>)",
          "Instant Turbo page transitions without full-page reloads"
        ],
        link: "/docs/views",
        tab1: "views/welcome.bir",
        tab2: "layouts/app.bir"
      },
      queues: {
        title: "Background Queues & Jobs",
        desc: "Offload long-running tasks, transactional emails, and external webhooks effortlessly with SQLite and Redis queue drivers.",
        bullets: [
          "Generate jobs with <code class='font-mono'>bir make:job</code>",
          "Delayed job execution (<code class='font-mono'>delaySeconds</code>)",
          "SQLite and Redis queue storage backends",
          "Production queue daemon with <code class='font-mono'>bir queue:work</code>"
        ],
        link: "/docs/queues",
        tab1: "app/jobs/SendEmailJob.ts",
        tab2: "QueueManager.ts"
      },
      broadcast: {
        title: "Real-Time WebSockets & Broadcast",
        desc: "Built-in WebSocket server with zero third-party dependencies. Broadcast real-time events to frontend channels with a single line of code.",
        bullets: [
          "RFC 6455 compliant native WebSocket server",
          "Channel subscriptions and selective room broadcasting",
          "Broadcast anywhere with <code class='font-mono'>Broadcast.to('channel').emit()</code>",
          "Zero external server or SaaS subscription required"
        ],
        link: "/docs/broadcasting",
        tab1: "routes/api.ts",
        tab2: "WebSocketServer.ts"
      },
      testing: {
        title: "Built-in HTTP Testing Client",
        desc: "Write clean, fluent integration and end-to-end tests using the native Node.js test runner. No external HTTP server or port conflicts.",
        bullets: [
          "Native Node.js test runner integration (<code class='font-mono'>node:test</code>)",
          "Fluent assertions: <code class='font-mono'>assertOk()</code>, <code class='font-mono'>assertSee()</code>, <code class='font-mono'>assertJson()</code>",
          "Automatic cookie, session, and redirect tracking",
          "Fast in-memory execution in under 2 seconds"
        ],
        link: "/docs/testing",
        tab1: "tests/posts.test.ts",
        tab2: "TestClient.ts"
      }
    };

    function switchShowcase(key) {
      const data = showcaseData[key];
      if (!data) return;

      // Update Nav Buttons
      document.querySelectorAll('#showcase-nav button').forEach(btn => {
        btn.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-zinc-950', 'dark:text-white', 'shadow-xs');
      });
      const activeBtn = document.getElementById('nav-btn-' + key);
      if (activeBtn) {
        activeBtn.classList.add('bg-white', 'dark:bg-zinc-800', 'text-zinc-950', 'dark:text-white', 'shadow-xs');
      }

      // Update Text Content
      document.getElementById('showcase-title').innerText = data.title;
      document.getElementById('showcase-desc').innerText = data.desc;
      document.getElementById('showcase-link').href = data.link;

      // Update Bullets
      const bulletsEl = document.getElementById('showcase-bullets');
      bulletsEl.innerHTML = data.bullets.map(b => `
        <li class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">&check;</span>
          <span>${b}</span>
        </li>
      `).join('');

      // Update Tabs Label
      document.getElementById('tab-label-1').innerText = data.tab1;
      document.getElementById('tab-label-2').innerText = data.tab2;

      // Update Code Pre Panels
      document.querySelectorAll('[id^="code-content-"]').forEach(pre => pre.classList.add('hidden'));
      const activePre = document.getElementById('code-content-' + key);
      if (activePre) {
        activePre.classList.remove('hidden');
        document.getElementById('showcase-active-code').innerText = activePre.innerText;
      }
    }

    // Initialize default showcase
    switchShowcase('auth');
  </script>
</x-layouts.app>
