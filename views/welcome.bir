        <div class="p-6 text-xs sm:text-[13px] font-mono leading-relaxed text-zinc-300 overflow-x-auto">
          <!-- Tour 1: Routing -->
          <pre id="tour-code-routing" class="tour-panel"><code>import { Route, type Context } from 'birframework';
import { PostController } from '../app/controllers/PostController.js';

const posts = new PostController();

// Resourceful routing
Route.get('/posts', (ctx: Context) => posts.index(ctx));
Route.get('/posts/:slug', (ctx: Context) => posts.show(ctx));

// Validated form requests with automatic middleware resolution
Route.group({ prefix: '/api/v1', middleware: ['auth'] }, () => {
  Route.post('/posts', async (ctx: Context) => {
    const data = await ctx.validate({
      title: 'required|string|min:3',
      content: 'required|string'
    });
    return ctx.json({ status: 'created', data }, 201);
  });
});

// Render server views with Instant Turbo client navigation
Route.get('/', (ctx: Context) => {
  return ctx.render('welcome', { title: 'BirFramework' });
});</code></pre>

          <!-- Tour 2: Model -->
          <pre id="tour-code-orm" class="tour-panel hidden"><code>import { Model, DB } from 'birframework';

export class Post extends Model {
  public static override table = 'posts';
  public static override softDeletes = true;

  // Fluent relationship queries
  public comments() {
    return this.hasMany('comments', 'post_id');
  }

  // Automatic Lifecycle Hooks
  public override beforeCreate() {
    if (!this.attributes['slug']) {
      this.attributes['slug'] = String(this.attributes['title']).toLowerCase().replace(/\s+/g, '-');
    }
  }
}

// Type-inferred queries across SQLite, PostgreSQL, and MySQL
const publishedPosts = await Post.where('status', '=', 'published')
  .orderBy('created_at', 'desc')
  .paginate({ perPage: 10 });</code></pre>

          <!-- Tour 3: .bir Template -->
          <pre id="tour-code-view" class="tour-panel hidden"><code>@verbatim&lt;x-layouts.app title="{{ title }}"&gt;
  &lt;div class="max-w-4xl mx-auto py-12"&gt;
    &lt;h1 class="text-2xl font-bold"&gt;{{ title }}&lt;/h1&gt;

    &lt;!-- Blade Syntax & Directives --&gt;
    @foreach(posts as post)
      &lt;article class="border-b border-zinc-200 dark:border-zinc-800 py-4"&gt;
        &lt;h2 class="text-base font-semibold"&gt;{{ post.title }}&lt;/h2&gt;
        &lt;p class="text-xs text-zinc-500"&gt;{{ post.created_at }}&lt;/p&gt;
      &lt;/article&gt;
    @endforeach

    &lt;!-- Instant Turbo page navigation --&gt;
    {!! paginationHtml !!}
  &lt;/div&gt;

  &lt;x-slot name="footer"&gt;
    &lt;span class="text-xs text-zinc-500"&gt;Rendered with .bir Template Engine&lt;/span&gt;
  &lt;/x-slot&gt;
&lt;/x-layouts.app&gt;@endverbatim</code></pre>

          <!-- Tour 4: Broadcast -->
          <pre id="tour-code-broadcast" class="tour-panel hidden"><code>import { Broadcast, Route, type Context } from 'birframework';

// Zero-dependency native WebSocket server
Route.post('/orders', async (ctx: Context) => {
  const order = await ctx.body();

  // Instant real-time broadcast to all connected WebSocket clients on channel 'orders'
  Broadcast.to('orders').emit('OrderCreated', {
    orderId: order.id,
    customer: order.customerName,
    amount: order.total
  });

  return ctx.json({ status: 'dispatched' });
});</code></pre>

