  <!-- Tour Tab Controller -->
  <script>
    function switchCodeTour(tab) {
      document.querySelectorAll('.tour-panel').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('[id^="tour-btn-"]').forEach(btn => {
        btn.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-white', 'shadow-xs');
        btn.classList.add('text-zinc-600', 'dark:text-zinc-400');
      });

      const activePre = document.getElementById('tour-code-' + tab);
      const activeBtn = document.getElementById('tour-btn-' + tab);
      const fileLabel = document.getElementById('tour-filename');

      const filenames = {
        routing: 'routes/web.ts',
        orm: 'app/models/Post.ts',
        view: 'views/welcome.bir',
        broadcast: 'app/events/OrderCreated.ts'
      };

      if (activePre) activePre.classList.remove('hidden');
      if (activeBtn) {
        activeBtn.classList.remove('text-zinc-600', 'dark:text-zinc-400');
        activeBtn.classList.add('bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-white', 'shadow-xs');
      }
      if (fileLabel && filenames[tab]) {
        fileLabel.innerText = filenames[tab];
      }

      const activeContainer = document.getElementById('tour-active-code');
      if (activeContainer && activePre) {
        activeContainer.innerText = activePre.innerText;
      }
    }

    // Initialize default tab
    switchCodeTour('routing');
  </script>
</x-layouts.app>
