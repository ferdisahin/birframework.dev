<x-layouts.app title="BirFramework - Full-Stack Web Framework for Node.js & TypeScript">
  <!-- Minimalist Hero -->
  <section class="pt-24 sm:pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-xs font-mono font-medium text-zinc-500 mb-6">
        BirFramework &bull; v0.4.0
      </p>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-zinc-950 dark:text-white leading-[1.1]">
        Full-stack TypeScript,<br class="hidden sm:inline"> built for developer happiness.
      </h1>

      <p class="mt-6 text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        ActiveRecord models, migrations, background queues, and server-rendered templates in one cohesive framework. Zero configuration ceremonies.
      </p>

      <!-- Clean Install Command -->
      <div class="mt-8 flex items-center justify-center gap-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-md bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-mono text-zinc-800 dark:text-zinc-200">
          <span class="text-zinc-400 select-none">$</span>
          <span id="cmd-install">npx birframework new my-app</span>
          <button data-copy="#cmd-install" class="ml-2 pl-2 border-l border-zinc-300 dark:border-zinc-700 text-zinc-500 hover:text-zinc-950 dark:hover:text-white transition">
            copy
          </button>
        </div>

        <a href="/docs/installation" class="px-4 py-2 rounded-md bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 text-xs font-medium hover:opacity-90 transition">
          Documentation &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Real Code Example (Clean, straightforward) -->
  <section class="py-12 border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-4 flex items-center justify-between text-xs text-zinc-500">
        <span class="font-mono">routes/web.ts</span>
        <button data-copy="#main-code" class="hover:text-zinc-900 dark:hover:text-white transition">
          Copy
        </button>
      </div>

      <div class="border border-zinc-200 dark:border-zinc-800 rounded-lg p-5 bg-zinc-950 text-xs font-mono leading-relaxed text-zinc-300 overflow-x-auto">
        <pre id="main-code"><code>import { Route, type Context } from 'birframework';
import { Post } from './app/models/Post.js';

// Clean route handling
Route.get('/', async (ctx: Context) => {
  const posts = await Post.where('published', '=', true)
    .orderBy('created_at', 'desc')
    .paginate({ perPage: 10 });

  return ctx.render('welcome', { posts });
});

// JSON API endpoint with built-in validation
Route.post('/api/posts', async (ctx: Context) => {
  const data = await ctx.validate({
    title: 'required|string|min:3',
    body: 'required|string',
  });

  const post = await Post.create(data);
  return ctx.json({ status: 'created', post }, 201);
});</code></pre>
      </div>
    </div>
  </section>

  <!-- Core Architecture Columns (Honest, clean breakdown) -->
  <section class="py-16 border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-xl font-bold tracking-tight text-zinc-950 dark:text-white mb-8">
        What's included out of the box
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm">
        <div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">ActiveRecord ORM</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-xs leading-relaxed">
            Fluent schema migrations, relationships, model lifecycle hooks, and soft deletes. Supports SQLite, PostgreSQL, and MySQL without configuration.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">.bir Template Engine</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Laravel Blade syntax with instant client-side navigation. Build fast server-rendered HTML applications without client-side bundle weight.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Background Queues &amp; Jobs</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Offload emails and background work asynchronously. Built-in SQLite and Redis drivers with retry strategies and queue worker CLI.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">WebSockets &amp; Broadcast</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Native, zero-dependency WebSocket server. Broadcast real-time events to frontend channels with <code class="font-mono">Broadcast.to('channel').emit()</code>.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Interactive Error Screen</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            In-browser debug inspector showing highlighted code lines, stack traces, and request context whenever an exception occurs during development.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Artisan-Style CLI</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Scaffold models, migrations, seeders, controllers, jobs, and mailables with simple <code class="font-mono">bir make:*</code> commands.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Source Reference Projects -->
  <section class="py-16 border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-xl font-bold tracking-tight text-zinc-950 dark:text-white mb-2">
        Reference Applications
      </h2>
      <p class="text-xs text-zinc-600 dark:text-zinc-400 mb-6">
        Real-world, fully tested open-source applications built with BirFramework:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="https://github.com/ferdisahin/BirFramework" target="_blank" class="block p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition">
          <div class="font-semibold text-sm text-zinc-950 dark:text-white">bir-blog</div>
          <div class="text-xs text-zinc-500 mt-1">Full publishing platform with auth, posts, comments, and .bir templates.</div>
        </a>

        <a href="https://github.com/ferdisahin/BirFramework" target="_blank" class="block p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition">
          <div class="font-semibold text-sm text-zinc-950 dark:text-white">bir-saas</div>
          <div class="text-xs text-zinc-500 mt-1">Subscription billing, metered developer API keys, and automated invoices.</div>
        </a>
      </div>
