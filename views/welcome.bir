  <!-- Interactive Tab Switch Script -->
  <script>
    function switchTab(name) {
      document.querySelectorAll('.code-panel').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-zinc-800', 'text-white');
        btn.classList.add('text-zinc-400');
      });

      const activePre = document.getElementById('code-' + name);
      const activeBtn = document.getElementById('tab-' + name);
      if (activePre) activePre.classList.remove('hidden');
      if (activeBtn) {
        activeBtn.classList.remove('text-zinc-400');
        activeBtn.classList.add('bg-zinc-800', 'text-white');
      }

      const activeContainer = document.getElementById('active-code');
      if (activeContainer && activePre) {
        activeContainer.innerText = activePre.innerText;
      }
    }
    // Initialize default tab
    switchTab('routes');
  </script>
</x-layouts.app>
